{
    "label": "Build OpenGL (MSYS2 MINGW64)",
    "type": "shell",
    "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
    "args": [
        "-std=c++17",
        "-g",

        "main.cpp",
        "draw.cpp",
        "input.cpp",
        "scene.cpp",
        "texture.cpp",
        "shader.cpp",
        "drawlevel.cpp",
        "utils/maploader.cpp",
        "utils/levelmetrics.cpp",

        "-o",
        "app.exe",

        "-lglew32",
        "-lfreeglut",
        "-lopengl32",
        "-lglu32"
    ],
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "problemMatcher": ["$gcc"],
    "group": {
        "kind": "build",
        "isDefault": true
    }
}
